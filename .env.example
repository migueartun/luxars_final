# URL de la API para el frontend. En desarrollo local puede omitirse:
# el frontend usará automáticamente el mismo equipo en el puerto 8000.
VITE_API_URL=http://127.0.0.1:8000/api/

# Local dev without IPv6: Supabase direct host (db.*.supabase.co) is IPv6-only.
# If your network cannot reach it (Network is unreachable / Connection timed out),
# set USE_SQLITE=True to use local SQLite, or switch DB_HOST to the Supabase pooler:
# DB_HOST=aws-0-us-east-1.pooler.supabase.com (IPv4, requires pooler credentials)
# Example:
USE_SQLITE=True

# Email (Gmail con contraseña de aplicación)
# Genera una en: https://myaccount.google.com/apppasswords
# Si dejas EMAIL_HOST_USER vacío, los correos se imprimen en la consola.
